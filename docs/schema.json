{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "seed": {
      "default": 1,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "terrain": {
      "type": "object",
      "properties": {
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] in metres; origin at (0,0) bottom-left"
        },
        "cell": {
          "default": 4,
          "type": "number",
          "minimum": 1,
          "maximum": 50
        },
        "baseHeight": {
          "default": 0,
          "type": "number"
        },
        "seaLevel": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        },
        "features": {
          "default": [],
          "description": "Smooth bumps (height > 0) or basins (height < 0), ~5% of height left at `radius`",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2,
                "description": "[x, y] in metres; x = east, y = north"
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "at",
              "radius",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "noise": {
          "default": {
            "amplitude": 2,
            "scale": 120
          },
          "type": "object",
          "properties": {
            "amplitude": {
              "type": "number",
              "minimum": 0
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "amplitude",
            "scale"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "size"
      ],
      "additionalProperties": false
    },
    "tracks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "loop",
              "line"
            ]
          },
          "points": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[x, y] in metres; x = east, y = north"
                },
                {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "[x, y] in metres; x = east, y = north"
                    },
                    "z": {
                      "description": "Fixed track height (m) at this waypoint; a hard constraint",
                      "type": "number"
                    },
                    "radius": {
                      "description": "Curve radius at this corner; overrides track.minRadius",
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "at"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "minRadius": {
            "default": 40,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxGrade": {
            "default": 0.035,
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.2
          },
          "from": {
            "description": "line only: starts at a junction on another track",
            "type": "object",
            "properties": {
              "track": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Parent track id"
              },
              "at": {
                "type": "number",
                "description": "Arc length s on the parent track (m)"
              },
              "heading": {
                "default": "forward",
                "description": "Which way along the parent the branch leaves (from) or arrives (to)",
                "type": "string",
                "enum": [
                  "forward",
                  "backward"
                ]
              }
            },
            "required": [
              "track",
              "at"
            ],
            "additionalProperties": false
          },
          "to": {
            "description": "line only: ends at a junction on another track",
            "type": "object",
            "properties": {
              "track": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Parent track id"
              },
              "at": {
                "type": "number",
                "description": "Arc length s on the parent track (m)"
              },
              "heading": {
                "default": "forward",
                "description": "Which way along the parent the branch leaves (from) or arrives (to)",
                "type": "string",
                "enum": [
                  "forward",
                  "backward"
                ]
              }
            },
            "required": [
              "track",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "points"
        ],
        "additionalProperties": false
      }
    },
    "stations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "track": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "at": {
            "type": "number",
            "description": "s of the platform centre (m)"
          },
          "length": {
            "default": 120,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "side": {
            "default": "right",
            "type": "string",
            "enum": [
              "left",
              "right",
              "both"
            ]
          },
          "building": {
            "default": "station-building",
            "description": "Object drawn as the station building beside the platform, or null for none",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "track",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "train": {
            "type": "string",
            "description": "Train type id: regional-3, express-6, freight-10, tram-2"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "route": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "description": "Ordered track ids; consecutive ids must share a junction"
          },
          "mode": {
            "type": "string",
            "enum": [
              "loop",
              "shuttle"
            ]
          },
          "stops": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "dwell": {
            "default": 25,
            "type": "number",
            "minimum": 0
          },
          "count": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "id",
          "train",
          "route",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "roads": {
      "default": [],
      "description": "Road network: crossroads form automatically, level crossings where a road meets a track at grade",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "default": "line",
            "type": "string",
            "enum": [
              "line",
              "loop"
            ]
          },
          "points": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[x, y] in metres; x = east, y = north"
                },
                {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "[x, y] in metres; x = east, y = north"
                    },
                    "z": {
                      "description": "Fixed track height (m) at this waypoint; a hard constraint",
                      "type": "number"
                    },
                    "radius": {
                      "description": "Curve radius at this corner; overrides track.minRadius",
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "at"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Waypoints like a track's; corners are rounded with `minRadius`"
          },
          "width": {
            "default": 6,
            "description": "Carriageway width (m); two-way traffic, drive on the right",
            "type": "number",
            "minimum": 3,
            "maximum": 14
          },
          "minRadius": {
            "default": 10,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxGrade": {
            "default": 0.08,
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.25
          },
          "speed": {
            "default": 13,
            "description": "Speed limit (m/s); 13 ≈ 50 km/h",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 40
          },
          "sidewalks": {
            "default": "none",
            "description": "Raised pavements beside the carriageway, left/right of the direction of increasing s; people walk on them",
            "type": "string",
            "enum": [
              "none",
              "both",
              "left",
              "right"
            ]
          },
          "sidewalkWidth": {
            "default": 2,
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "from": {
            "type": "object",
            "properties": {
              "road": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Road this one starts (from) or ends (to) on, forming a T-junction"
              },
              "at": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "start",
                      "end"
                    ]
                  }
                ],
                "description": "Arc length s on that road (m), or \"start\" / \"end\" to join at one of its ends (a corner)"
              }
            },
            "required": [
              "road",
              "at"
            ],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "road": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "Road this one starts (from) or ends (to) on, forming a T-junction"
              },
              "at": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "start",
                      "end"
                    ]
                  }
                ],
                "description": "Arc length s on that road (m), or \"start\" / \"end\" to join at one of its ends (a corner)"
              }
            },
            "required": [
              "road",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "points"
        ],
        "additionalProperties": false
      }
    },
    "paths": {
      "default": [],
      "description": "Footpaths: junctions form automatically, zebra crossings where a path crosses a road, foot crossings over tracks",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "default": "line",
            "type": "string",
            "enum": [
              "line",
              "loop"
            ]
          },
          "points": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[x, y] in metres; x = east, y = north"
                },
                {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "[x, y] in metres; x = east, y = north"
                    },
                    "z": {
                      "description": "Fixed track height (m) at this waypoint; a hard constraint",
                      "type": "number"
                    },
                    "radius": {
                      "description": "Curve radius at this corner; overrides track.minRadius",
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "at"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Waypoints like a road's; corners are rounded with `minRadius`"
          },
          "width": {
            "default": 2,
            "description": "Path width (m)",
            "type": "number",
            "minimum": 0.8,
            "maximum": 6
          },
          "surface": {
            "default": "gravel",
            "type": "string",
            "enum": [
              "gravel",
              "paved"
            ]
          },
          "minRadius": {
            "default": 3,
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maxGrade": {
            "default": 0.12,
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.3
          },
          "from": {
            "type": "object",
            "properties": {
              "path": {
                "description": "Path this one starts (from) or ends (to) on, forming a T-junction",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "road": {
                "description": "Road whose edge this path starts or ends at, joining its sidewalk on that side",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "at": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "start",
                      "end"
                    ]
                  }
                ],
                "description": "Arc length s on that path or road (m), or \"start\" / \"end\""
              }
            },
            "required": [
              "at"
            ],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "path": {
                "description": "Path this one starts (from) or ends (to) on, forming a T-junction",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "road": {
                "description": "Road whose edge this path starts or ends at, joining its sidewalk on that side",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "at": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "start",
                      "end"
                    ]
                  }
                ],
                "description": "Arc length s on that path or road (m), or \"start\" / \"end\""
              }
            },
            "required": [
              "at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "points"
        ],
        "additionalProperties": false
      }
    },
    "pedestrians": {
      "default": {},
      "type": "object",
      "properties": {
        "count": {
          "description": "People walking the paths and sidewalks; default about one per 25 m of walkway",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "traffic": {
      "default": {},
      "type": "object",
      "properties": {
        "cars": {
          "description": "Number of vehicles; default about one per 70 m of road",
          "type": "integer",
          "minimum": 0,
          "maximum": 400
        },
        "vehicles": {
          "default": [
            "car",
            "car",
            "car",
            "van",
            "bus",
            "truck"
          ],
          "description": "Object ids to drive, picked at random (repeat an id to make it more common)",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "default": {},
      "description": "Custom scenery objects for this layout, by id; they may also redefine built-in ids",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "description": "What it is, for people and LLMs reading the layout",
            "type": "string"
          },
          "parts": {
            "minItems": 1,
            "maxItems": 300,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "shape": {
                  "type": "string",
                  "enum": [
                    "box",
                    "pyramid",
                    "gable",
                    "cylinder",
                    "cone",
                    "sphere",
                    "panel"
                  ],
                  "description": "box | pyramid (a box narrowing to a point) | gable (triangular roof prism, ridge along x) | cylinder | cone | sphere | panel (only the box's front (+x) face, one-sided: windows, doors, signs)"
                },
                "at": {
                  "default": [
                    0,
                    0,
                    0
                  ],
                  "description": "Bottom centre of the part in the object frame [x front, y left, z up] (m); negative z sinks it into the ground",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "size": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3,
                  "description": "Extent [along x, along y, height] in metres, before rotation"
                },
                "rotate": {
                  "default": [
                    0,
                    0,
                    0
                  ],
                  "description": "Degrees about x, then y, then z (right-handed), pivoting on `at`",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "color": {
                  "default": "tint",
                  "description": "\"#rrggbb\", a named colour, or \"tint\": the per-placement colour picked from the object's `tint`",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "wall",
                        "plaster",
                        "brick",
                        "stone",
                        "concrete",
                        "wood",
                        "timber",
                        "metal",
                        "dark",
                        "white",
                        "red",
                        "yellow",
                        "blue",
                        "green",
                        "roof",
                        "roof-slate",
                        "roof-dark",
                        "roof-grey",
                        "chimney",
                        "trunk",
                        "window",
                        "lamp",
                        "snow",
                        "sand",
                        "water",
                        "grass",
                        "foliage",
                        "needles"
                      ]
                    },
                    {
                      "type": "string",
                      "const": "tint"
                    }
                  ]
                },
                "winter": {
                  "description": "Colour used in winter instead, e.g. \"snow\" on a roof",
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    {
                      "type": "string",
                      "enum": [
                        "wall",
                        "plaster",
                        "brick",
                        "stone",
                        "concrete",
                        "wood",
                        "timber",
                        "metal",
                        "dark",
                        "white",
                        "red",
                        "yellow",
                        "blue",
                        "green",
                        "roof",
                        "roof-slate",
                        "roof-dark",
                        "roof-grey",
                        "chimney",
                        "trunk",
                        "window",
                        "lamp",
                        "snow",
                        "sand",
                        "water",
                        "grass",
                        "foliage",
                        "needles"
                      ]
                    },
                    {
                      "type": "string",
                      "const": "tint"
                    }
                  ]
                },
                "seasons": {
                  "description": "Only draw this part in these seasons",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "summer",
                      "autumn",
                      "winter"
                    ]
                  }
                },
                "sides": {
                  "description": "cylinder / cone: number of sides (default 8 / 6)",
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 32
                },
                "taper": {
                  "description": "box, pyramid, cylinder, cone: top size as a fraction of the bottom, one number or [x, y]. Defaults: box and cylinder 1, pyramid and cone 0",
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        {
